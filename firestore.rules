rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidPriority(p) {
      return p in ['HIGH', 'MEDIUM', 'LOW'];
    }

    function isValidCategory(c) {
      return c is string && c.size() > 0 && c.size() <= 50;
    }

    function isValidTask(data) {
      return isSignedIn() &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             isValidCategory(data.category) &&
             isValidPriority(data.priority) &&
             (!('reminderTimestamp' in data) || data.reminderTimestamp is int) &&
             data.isCompleted is bool;
    }

    match /users/{userId}/tasks/{taskId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(taskId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'category', 'priority', 'isCompleted', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'description', 'category', 'priority', 'reminderTimestamp', 'isCompleted', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidTask(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(taskId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priority', 'reminderTimestamp', 'isCompleted', 'updatedAt']) &&
                       isValidTask(incoming());

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(taskId);
    }
  }
}
